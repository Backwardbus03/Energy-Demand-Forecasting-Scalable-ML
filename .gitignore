# Secrets and environment variables
.env
.env.*
!.env.example
*.key
*.pem

# Data (tracked via DVC/S3, never committed to git)
/data/
!/data/**/.gitkeep

# Model weights and artifacts (tracked via MLflow / Model Registry / S3)
/models/*
!/models/.gitkeep
*.joblib
*.pkl
*.pickle
*.onnx

# MLflow & Optuna tracking
mlruns/
mlartifacts/
*.sqlite
*.sqlite3
optuna.db

# Airflow local state
.airflow/
airflow.db
airflow.cfg

# Logs
logs/
*.log

# Python cache and builds
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
ENV/

# Jupyter Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Testing & Coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Operating System & IDEs
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
