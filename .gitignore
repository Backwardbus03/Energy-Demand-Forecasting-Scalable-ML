# Secrets
.env
*.key

# Data (tracked via DVC/S3 later, never committed).
# Leading slash anchors this to the project root - a bare `data/` would also
# match src/data/, silently excluding the pipeline source code.
/data/
!/data/**/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Notebooks
.ipynb_checkpoints/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS / IDE
.DS_Store
.vscode/
.idea/
